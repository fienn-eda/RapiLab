ription_value_07":"","description_value_08":"","description_value_09":"","description_value_10":"","description_value_11":""},{"description_value_01":"437.06","description_value_02":"3","description_value_03":"","description_value_04":"","description_value_05":"","description_value_06":"","description_value_07":"","description_value_08":"","description_value_09":"","description_value_10":"","description_value_11":""},{"description_value_01":"457.87","description_value_02":"3","description_value_03":"","description_value_04":"","description_value_05":"","description_value_06":"","description_value_07":"","description_value_08":"","description_value_09":"","description_value_10":"","description_value_11":""}]}],"__v":0,"skillprio":{"_id":"6a595a0508eb649335c2ae0d","name":"Privaty","PvP?":"FALSE","Budget Skill investments":"7/4/4","Recommended Skill Investments":"10/4/4","Skill Order Priority":"S1 > S2","Priority":"High","Notes":"Skill 1 has really good scaling regarding the reload buff, and also gives a good attack buff; also scales well late game as her reduced mag debuff does not account for max ammo increases from Overload equipment. For example, if Scarlet has 30 ammo, Privaty would only reduce her ammo by 10 instead of 15 as Scarlet’s base ammo count is only 20 unbuffed, basically reducing the mag debuff handicap even more.\nTLDR: Privaty’s Skill 1 has great scaling for units that have OL equipments with the ammo max increase stat.\nSkill 2 can hit hard in PvE mob content, but useless in boss stages\nBurst is not very important but still worth some investment; not very important as her stun is the main sought after part of the skill, not the damage.","id":69},"tierlist":{"name":"Privaty","Tier List":"Tier List","Combined":"A","Story":"A","Boss":"A","PvP":"C","Wishlist":"","isNew":"FALSE","reqHands":"FALSE","reqInvest":"FALSE","strongEarly":"FALSE","Cube Reqs":"Cube Reqs","cubes":"Resilience Cube,","cubeNotes":"Has last bullet mechanic, avoid ammo-increasing cubes.","Skill Prios":"Skill Prios","SkillPrioPvp":"FALSE","SkillPrioBudget":"7/4/4","SkillPrioReq":"10/4/4","SkillPrioOrder":"S1 > S2","SkillPrioImportance":"High","SkillPrioNotes":"Skill 1 has really good scaling regarding the reload buff, and also gives a good attack buff; also scales well late game as her reduced mag debuff does not account for max ammo increases from Overload equipment. For example, if Scarlet has 30 ammo, Privaty would only reduce her ammo by 10 instead of 15 as Scarlet’s base ammo count is only 20 unbuffed, basically reducing the mag debuff handicap even more.\r\nTLDR: Privaty’s Skill 1 has great scaling for units that have OL equipments with the ammo max increase stat.\r\n\r\nSkill 2 can hit hard in PvE mob content, but useless in boss stages\r\n\r\nBurst is not very important but still worth some investment; not very important as her stun is the main sought after part of the skill, not the damage.","Overload Prios":"Overload Prios","OPEleDmgDealt":"","OPHitRate":"","OPMaxAmmo":"","OPATK":"","OPChDMG":"","OPChSpeed":"","OPCRate":"","OPCDMG":"","OPDFEF":"","OPPrio":"","OPNotes":"","roles":"DPS, Offensive Support","summary":"Decent burst III buffer as she provides good reload speed buffs which increases overall team uptime despite the debuff on ammo. Privaty's Ammo debuff is \"additive\", which means overloaded gear with max ammo rolls can \"cancel\" out her debuff. Privaty is usually used in sniper teams for near 100% reload speed or in Dorothy teams for smoother cool down rotations due to the synergy between Dorothy (last bullet in mag reduces full burst cooldown) and Privaty (reduced ammo capacity). Privaty's full screen stun can enable unique Campaign and PvP plays.","id":19},"tierlist2":{"name":"Privaty (Treasure)","Tier List":"Tier List","Combined":"SSS","Story":"SS","Boss":"SSS","PvP":"S","Wishlist":"","isNew":"FALSE","reqHands":"FALSE","reqInvest":"TRUE","strongEarly":"FALSE","Cube Reqs":"Cube Reqs","cubes":"Resilience Cube","cubeNotes":"Since she doesn't want any sort of ammo extension, Resilience over Bastion, every time.","Skill Prios":"Skill Prios","SkillPrioPvp":"TRUE","SkillPrioBudget":"7/7/4","SkillPrioReq":"10/7/7","SkillPrioOrder":"S1 = S2","SkillPrioImportance":"Highest","SkillPrioNotes":"Skill 1 with Treasure available now provides her with an Attack Damage Boost. It combines with the ATK buff, Reload Speed buff and new Damage Taken debuff from S2 to provide a lot of damage effects vs enemies, especially bosses.\n\nSkill 2 not only deals relevant damage with Treasure, but now has a Damage Taken debuff. Even though the damage taken portion scales poorly, all the damage bonuses for the team from S1 pair up well in off-burst compositions. The damage activation will stack up as a fight progresses. Level it up to max eventually if using Privaty to deal DPS to Water-weak enemies.\n\nBurst has better damage and buffs her Elemental damage against Water-weak enemies, and causes her S2 to deal significantly increased damage. It can be leveled to 10 eventually to turn Privaty into one of the main units to use in Water-weak content.","Overload Prios":"Overload Prios","OPEleDmgDealt":"","OPHitRate":"","OPMaxAmmo":"","OPATK":"","OPChDMG":"","OPChSpeed":"","OPCRate":"","OPCDMG":"","OPDFEF":"","OPPrio":"","OPNotes":"","roles":"DPS, Support, Buffer","summary":null,"id":194},"recommendations":{"_id":"6a595a4208eb649335c2ae7d","name":"Privaty","main":"Resilience Cube","alternative":"","notes":"Has last bullet mechanic, avoid ammo-increasing cubes.","id":75},"overloadrecs":{"_id":"6a595af908eb649335c2b05b","name":"Privaty","Element Damage Dealt":null,"Hit Rate":null,"Max Ammunition Capacity":null,"ATK":null,"Charge Damage":null,"Charge Speed":null,"Critical Rate":null,"Critical Damage":null,"DEF":null,"Prio":null,"Notes":null,"id":67},"dollskills":[{"id":2170151,"name":"EX Magazine","description":"■ Activates when entering Full Burst. Affects all allies.\n<color=#00AEFF>ATK ▲ {description_value_01}% for {descr