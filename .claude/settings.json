{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/sync_worktree_data.py\" --quiet || true",
            "statusMessage": "Syncing worktree data/ from main...",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
